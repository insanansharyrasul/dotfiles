(defvar eww "eww -c $HOME/.config/eww")

;; ──────────────────────────── Variables ────────────────────────────
(deflisten workspace-h :initial "(box :class \"works\")" "exec scripts/workspaces.sh")
(deflisten submap    :initial "" "exec scripts/submap.sh")
(deflisten volume     :initial '{"level":0,"icon":"󰕿"}' "exec scripts/audio.sh sink listen")
(deflisten mic        :initial '{"level":0,"icon":"󰍬"}' "exec scripts/audio.sh source listen")
(deflisten brightness :initial "0" "exec brightness_listener listen")
(deflisten notifications :initial '{"count":0,"state":"none","icon":"󰂜"}' "exec scripts/notifications.sh listen")
(deflisten memory       :initial "0" "exec ram_usage")
(deflisten cpu          :initial "0" "exec cpu_usage")
(deflisten idle_inhibit :initial "false" "exec idleinhibitor listen")
(defpoll battery :interval "10s" :initial '{"percent":0,"status":"","icon":""}' "scripts/battery.sh")
(defpoll wifi-icon       :interval "5s"  :initial "" "scripts/network.sh icon")
(defpoll wifi-name       :interval "5s"  :initial "" "scripts/network.sh name")
(defpoll tlp             :interval "5s"  :initial "{}" "$HOME/.dotfiles/.config/scripts/waybar-tlp-status.sh")
(defpoll privacy-mic     :interval "3s"  :initial "false" "scripts/privacy.sh")

(defpoll full-hour :interval "1s" :initial "" "date +'%H:%M:%S'")
(defpoll full-day  :interval "1s" :initial "" "date +'%d/%m/%y'")

(defvar power-reveal false)
(defvar waifu-path "/home/teaguy21/Pictures/waifu.jpeg")

;; ──────────────────────── Shared widgets ───────────────────────────

;; Launcher
(defwidget launcher []
  (button
    :class "launcher"
    :halign "center"
    :onclick "scripts/popup.sh launcher"
    :onrightclick "scripts/popup.sh waifu"
    ""
  ))

;; Wifi
(defwidget wifi []
  (button :onclick "scripts/popup.sh wifi" :class "wifi-button"
    (box :orientation "h" :space-evenly false
      (label :class "mod icon-wifi" :text "${wifi-icon}")
      (label :class "label-sm" :text "${wifi-name}")
    )
  )
  
)

;; Idle inhibitor
(defwidget idle []
  (button :class "mod icon-idle"
    :halign "center" :valign "center"
    :onclick "idleinhibitor toggle"
    {idle_inhibit ? "󰅶" : "󰾪"}
  ))

;; TLP profile
(defwidget tlp []
  (button :class "mod icon-tlp" :halign "center" :valign "center"
    :onclick "alacritty -e bash -c ~/.dotfiles/.config/scripts/tlp-interactive.sh"
    {tlp.text ?: "⚡"}
  ))

;; Calendar (popup window content)
(defwidget cal []
  (box :class "cal-box" :orientation "v"
    (calendar :class "cal")))

;; Waifu (popup window content)
(defwidget waifu []
  (box :class "waifu-box" :orientation "v"
    (overlay
      (image :path waifu-path :image-width 280 :image-height 200)
      (label :class "waifu-caption" :text "Wanted" :valign "start" :halign "center")
      (label :class "waifu-caption" :text "Dead or Live" :valign "end" :halign "center")
    )))

;; ──────────────────────────── Horizontal bar ───────────────────────

;; Workspaces
;; Clock (single row)
(defwidget clock-h []
  (button :class "clock"
    :onclick "scripts/popup.sh calendar"
    :onmiddleclick "$HOME/.config/hypr/scripts/toggle-wallpaper.sh"
    :onrightclick "$HOME/.config/swww/swww.sh"
    (box :orientation "h" :space-evenly false
      (label :class "clock-hour" :text "${full-hour}")
      (label :class "clock-day" :text "${full-day}")
    )))

;; Powermenu (sideways hover-reveal so bar height stays fixed)
(defwidget powermenu-h []
  (eventbox :onhover "${eww} update power-reveal=true" :onhoverlost "${eww} update power-reveal=false"
    (box :orientation "h" :space-evenly false :class "powermenu"
      (revealer   :transition "slideleft" :reveal power-reveal :duration "400ms"
        (box :orientation "h" :space-evenly false
          (button :class "pw-lock" :onclick "loginctl lock-session" "󰌾")
          (button :class "pw-logout" :onclick "hyprctl dispatch 'hl.dsp.exit()'" "󰍃")
          (button :class "pw-reboot" :onclick "systemctl reboot" "󰜉")
          (button :class "pw-sleep"  :onclick "systemctl suspend" "󰒲")
        )
      )
      (button :class "pw-power" :onclick "systemctl poweroff" "󰐥")
    )
  )
)

(defwidget bar-h []
  (box :class "eww_bar bar-h" :hexpand true :vexpand true
    (overlay :hexpand true :vexpand true
      (box :halign "end" :valign "center" :space-evenly false
        (box :orientation "h" :space-evenly false :class "control"
          (bat-h)
          (mic-h)
          (vol-h)
          (bri-h)
          (wifi)
          (privacy-h))
        (clock-h)
        (powermenu-h))
      (box :halign "start" :valign "center" :space-evenly false
        (launcher)
        (submap-h)
        (idle)
        (tlp)
        (notif-h)
        (cpu-h)
        (mem-h))
      (box :halign "center" :valign "center" :space-evenly false
        (literal :content workspace-h)))))

;; ──────────────────────── Horizontal stat widgets ──────────────────


;; Symbol (child) left, value right.
(defwidget stat [text ?class]
  (box :orientation "h" :space-evenly false :class "${class ?: 'stat'}" :valign "center"
    (children)
    (label :class "label-sm" :text text)))

(defwidget ring [class value]
  (box :class "ringgy"
    (circular-progress :value value :class class :thickness 4 :clockwise true
      (label :class "mem-icon" :text "ㅤ"))))

(defwidget cpu-h []
  (stat :class "stat-cpu" :text "${cpu}%"
    (ring :class "mem-ring-cpu" :value cpu)))

(defwidget mem-h []
  (stat :text "${memory}%"
    (ring :class "mem-ring" :value memory)))

(defwidget bat-h []
  (stat :text "${battery.percent}%"
    (label :class "icon-bat ${battery.status == 'Discharging' && battery.percent < 20 ? 'critical' : ''}" :text {battery.icon})))

(defwidget mic-h []
  (eventbox :onscroll "scripts/audio.sh source scroll {}" :valign "center" :onclick "scripts/audio.sh source mute"
    (stat :text "${mic.level}%"
      (button :class "icon-mic" {mic.icon}))))

(defwidget vol-h []
  (eventbox :onscroll "scripts/audio.sh sink scroll {}" :valign "center" :onclick "scripts/audio.sh sink mute" :onrightclick "scripts/popup.sh audio"
    (stat :text "${volume.level}%"
      (button :class "icon-vol" {volume.icon}))))

(defwidget bri-h []
  (eventbox :onscroll "brightness_listener scroll {}" :valign "center"
    (stat :text "${brightness}%"
      (label :class "icon-bright" :text "󰃠"))))

(defwidget notif-h []
  (button :class "icon-notif ${notifications.state}"
    :onclick "scripts/notifications.sh toggle"
    :onrightclick "scripts/notifications.sh dnd"
    :onmiddleclick "scripts/notifications.sh clear"
    (box :orientation "h" :space-evenly false :spacing 3 :valign "center"
      (label :class "notif-icon" :text {notifications.icon})
      (label :class "notif-count" :text {notifications.count > 0 ? notifications.count : ""})
    )))

;; Submap + privacy reveal by sliding horizontally, because a hidden
;; vertical revealer still reserves its child's width.

(defwidget submap-h []
  (revealer :transition "slideleft" :reveal {submap != ""} :duration "300ms"
    (label :class "submap" :text submap :limit-width 6)))

(defwidget privacy-h []
  (revealer :transition "slideleft" :reveal privacy-mic :duration "300ms" :valign "center"
    (label :class "privacy" :text "󰍬")))

;; ──────────────────────────── Windows ──────────────────────────────
;; Thickness: change :height here.
(defwindow bar [monitor]
  :geometry (geometry :x "0px" :y "0px" :width "100%" :height "30px" :anchor "top center")
  :monitor monitor
  :stacking "fg"
  :exclusive true
  (bar-h)
)

(defwindow calendar
  :geometry (geometry :x "8px" :y "8px" :width "290px" :height "210px" :anchor "top right")
  :monitor 0
  :stacking "fg"
  (cal)
)

(defwindow waifu
  :geometry (geometry :x "8px" :y "8px" :width "290px" :height "210px" :anchor "top left")
  :monitor 0
  :stacking "fg"
  (waifu)
)
