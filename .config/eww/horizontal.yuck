;; ──────────────────────────── Horizontal bar ───────────────────────
;; Everything the horizontal (top) bar needs. Included from eww.yuck;
;; shared variables (time, battery, users) live there.

(deflisten workspace-h :initial "(box :class \"works\")" "WORKSPACES_ORIENT=h exec scripts/workspaces.sh")

;; Workspaces
(defwidget workspaces-h []
  (literal :content workspace-h))

;; Clock (single row)
(defwidget clock-h []
  (button :class "clock"
    :onclick "scripts/popup.sh calendar"
    :onmiddleclick "$HOME/.config/hypr/scripts/toggle-wallpaper.sh"
    :onrightclick "$HOME/.config/swww/swww.sh"
    (box :orientation "h" :space-evenly false
      (label :class "clock-hour" :text "${hour}:${min}:${sec}")
      (label :class "clock-day" :text "${day}/${month}/${year}"))))

;; Powermenu (sideways hover-reveal so bar height stays fixed)
(defwidget powermenu-h []
  (eventbox :onhover "${eww} update power-reveal=true"
    :onhoverlost "${eww} update power-reveal=false"
    (box :orientation "h" :space-evenly false :class "powermenu"
      (revealer :transition "slideleft" :reveal power-reveal :duration "400ms"
        (box :orientation "h" :space-evenly false
          (button :class "pw-lock" :onclick "loginctl lock-session" "󰌾")
          (button :class "pw-logout" :onclick "hyprctl dispatch exit" "󰍃")
          (button :class "pw-reboot" :onclick "systemctl reboot" "󰜉")
          (button :class "pw-sleep"  :onclick "systemctl suspend" "󰒲")
        ))
      (button :class "pw-power" :onclick "systemctl poweroff" "󰐥"))))

(defwidget top-h []
  (box :orientation "h" :space-evenly false :halign "start" :valign "center"
    (launcher)
    (submap-h)
    (idle)
    (tlp)
    (notif-h)
  ))

(defwidget control-h []
  (box :orientation "h" :space-evenly false :halign "center" :valign "center" :class "control"
    (cpu-h)
    (mem-h)
    (bat-h)
    (mic-h)
    (vol-h)
    (bri-h)
    (wifi)
    (privacy-h)
  ))

(defwidget bottom-h []
  (box :orientation "h" :space-evenly false
    (clock-h)))

(defwidget end-h []
  (box :orientation "h" :space-evenly false :halign "end" :valign "center"
    (control-h)
    (bottom-h)
    (powermenu-h)
  ))

(defwidget bar-h []
  (box :class "eww_bar bar-h" :hexpand true :vexpand true
    (overlay :hexpand true :vexpand true
      (box :halign "start" :valign "center" :space-evenly false
        (top-h))
      (box :halign "center" :valign "center" :space-evenly false
        (workspaces-h))
      (box :halign "end" :valign "center" :space-evenly false
        (end-h))
    )
  )
)

;; Thickness: change :height here.
(defwindow bar-top-left
  :geometry (geometry :x "0px" :y "0px" :width "100%" :height "1px" :anchor "top center")
  :monitor "eDP-1"
  :stacking "fg"
  :exclusive true
  (bar-h)
)

(defwindow bar-top-right
  :geometry (geometry :x "0px" :y "0px" :width "100%" :height "1px" :anchor "top center")
  :monitor "HDMI-A-1"
  :stacking "fg"
  :exclusive true
  (bar-h)
)

;; ──────────────────────── Horizontal stat widgets ──────────────────
;; Same functionality as the vertical modules in eww.yuck, but laid out
;; on one line: symbol left, value right.

(defwidget cpu-h []
  (box :orientation "h" :space-evenly false :class "stat" :valign "center"
    (box :class "ringgy"
      (circular-progress :value cpu :class "mem-ring-cpu" :thickness 4 :clockwise true
        (label :class "mem-icon" :text "ㅤ")))
    (label :class "label-sm" :text "${cpu}%")))

(defwidget mem-h []
  (box :orientation "h" :space-evenly false :class "stat" :valign "center"
    (box :class "ringgy"
      (circular-progress :value memory :class "mem-ring" :thickness 4 :clockwise true
        (label :class "mem-icon" :text "ㅤ")))
    (label :class "label-sm" :text "${memory}%")))

(defwidget bat-h []
  (box :orientation "h" :space-evenly false :class "stat" :valign "center"
    (label :class "icon-bat ${battery-status == 'Discharging' && battery-percent < 20 ? 'critical' : ''}" :text battery-icon)
    (label :class "label-sm" :text "${battery-percent}%")))

(defwidget mic-h []
  (eventbox :onscroll "scripts/mic.sh scroll {}" :valign "center"
    (box :orientation "h" :space-evenly false :class "stat"
      (button :class "icon-mic" :onclick "scripts/mic.sh mute" {mic.icon})
      (label :class "label-sm" :text "${mic.level}%"))))

(defwidget vol-h []
  (eventbox :onscroll "scripts/volume.sh scroll {}" :valign "center"
    (box :orientation "h" :space-evenly false :class "stat"
      (button :class "icon-vol" :onclick "scripts/volume.sh mute" :onrightclick "scripts/popup.sh audio" {volume.icon})
      (label :class "label-sm" :text "${volume.level}%"))))

(defwidget bri-h []
  (eventbox :onscroll "brightness_listener scroll {}" :valign "center"
    (box :orientation "h" :space-evenly false :class "stat"
      (label :class "icon-bright" :text "󰃠")
      (label :class "label-sm" :text "${brightness}%"))))

(defwidget notif-h []
  (button :class "icon-notif ${notifications.state}"
    :onclick "scripts/notifications.sh toggle"
    :onrightclick "scripts/notifications.sh dnd"
    :onmiddleclick "scripts/notifications.sh clear"
    (box :orientation "h" :space-evenly false :spacing 3 :valign "center"
      (label :class "notif-icon" :text {notifications.icon})
      (label :class "notif-count" :text {notifications.count > 0 ? notifications.count : ""})
    )))

;; Submap + privacy on the horizontal bar reveal by sliding horizontally,
;; because a hidden vertical revealer still reserves its child's width.

(defwidget submap-h []
  (revealer :transition "slideleft" :reveal {submap != ""} :duration "300ms"
    (label :class "submap" :text submap :limit-width 6)))

(defwidget privacy-h []
  (revealer :transition "slideleft" :reveal privacy-mic :duration "300ms" :valign "center"
    (label :class "privacy" :text "󰍬")))

(defwidget cal []
  (box :class "cal-box" :orientation "v"
    (calendar :class "cal" :day calendar_day :month calendar_month :year calendar_year)))

(defwindow calendar-h
  :geometry (geometry :x "5px" :y "5px" :width "290px" :height "210px" :anchor "top right")
  :monitor 0
  :stacking "fg"
  (cal)
)
