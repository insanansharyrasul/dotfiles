{
    "files.autoSave": "afterDelay",
    "code-runner.executorMap": {
      "c": "cd $dir && gcc $fileName -o $fileNameWithoutExt -lm && $dir$fileNameWithoutExt && rm ./$fileNameWithoutExt",
      "cpp": "cd $dir && g++ -std=c++20 -O2 $fileName -o $fileNameWithoutExt && $dir$fileNameWithoutExt && rm ./$fileNameWithoutExt",
      "python": "python3 -u $filename",
      "typescript": "npx tsx"
    },
    "explorer.sortOrder": "type",
    "explorer.confirmDelete": false,
    "editor.wordWrap": "wordWrapColumn",
    "editor.wordWrapColumn": 200,
    "javascript.updateImportsOnFileMove.enabled": "always",
    "window.zoomLevel": -0.7,
    "editor.fontLigatures": true,
    "editor.fontFamily": "'Fira Code'",
    "code-runner.saveFileBeforeRun": true,
    "code-runner.saveAllFilesBeforeRun": true,
    "editor.mouseWheelZoom": true,
    "git.openRepositoryInParentFolders": "never",
    "git.autofetch": true,
    "git.confirmSync": false,
    "code-runner.runInTerminal": true,
    "vim.leader": "<Space>",
    "vim.hlsearch": true,
    "explorer.compactFolders": false,
    "vim.handleKeys": {
      "<C-d>": false,
      "<C-s>": false,
      "<C-z>": false
    },
    "diffEditor.hideUnchangedRegions.enabled": true,
    "explorer.confirmDragAndDrop": false,
    "editor.lineNumbers": "relative",
    "files.exclude": {
      "**/__pycache__": true,
      "**/*.out": true
    },
    "files.readonlyInclude":{
      "/.cargo/registry/src//*.rs": true,
      "/lib/rustlib/src/rust/library//*.rs": true,
    },
    "workbench.colorCustomizations": {
      "editorUnnecessaryCode.border": "#ff0000"
    },
    "typescript.suggest.paths": false,
    "javascript.suggest.paths": false,
    "diffEditor.ignoreTrimWhitespace": false,
    "editor.minimap.enabled": false,
    "terminal.integrated.fontFamily": "FiraCode Nerd Font Mono",
    "terminal.integrated.defaultProfile.linux": "fish",
    "terminal.integrated.focusAfterRun": "terminal",
    "workbench.colorTheme": "Ayu Dark",
    "[dart]": {
      "editor.formatOnSave": true,
      "editor.formatOnType": true,
      "editor.rulers": [
        80
      ],
      "editor.selectionHighlight": false,
      "editor.tabCompletion": "onlySnippets",
      "editor.wordBasedSuggestions": "off"
    },
    "extensions.experimental.affinity": {
      "vscodevim.vim": 1
    },
    "files.associations": {
      "*.rmd": "markdown"
    },
    "workbench.iconTheme": "material-icon-theme",
    "launch": {

      "configurations": [],
      "compounds": []
    },
    "cmake.pinnedCommands": [
      "workbench.action.tasks.configureTaskRunner",
      "workbench.action.tasks.runTask"
    ],
     "editor.largeFileOptimizations": false,
    "C_Cpp.default.cppStandard": "c++20",
    "editor.inlayHints.enabled": "offUnlessPressed",
    "window.commandCenter": false,
    "workbench.layoutControl.enabled": false,
    "mdb.confirmRunAll": false,
    "codesnap.transparentBackground": true,
    "C_Cpp.clang_format_fallbackStyle": "{ BasedOnStyle: Google, IndentWidth: 4, ColumnLimit: 0 }",
    "breadcrumbs.enabled": false,
    "terminal.integrated.commandsToSkipShell": [
      "code-runner.run",
      "workbench.action.toggleSidebarVisibility"
    ],
    "explorer.confirmPasteNative": false,
    "go.toolsManagement.autoUpdate": true
  }