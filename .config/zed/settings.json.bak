// Zed settings
//
// For information on how to configure Zed, see the Zed
// documentation: https://zed.dev/docs/configuring-zed
//
// To see all of Zed's default settings without changing your
// custom settings, run `zed: open default settings` from the
// command palette (cmd-shift-p / ctrl-shift-p)
{
  "edit_predictions": {
    "open_ai_compatible_api": {
      "max_output_tokens": 64
    }
  },
  "autosave": {
    "after_delay": {
      "milliseconds": 500
    }
  },
  "icon_theme": "Material Icon Theme",
  "agent": {
    "sandbox_permissions": {
      "network_hosts": [
        "github.com",
        "pypi.org",
        "files.pythonhosted.org",
        "api.maildrop.cc"
      ]
    },
    "default_profile": "write",
    "tool_permissions": {
      "tools": {
        "skill": {
          "default": "allow"
        },
        "search_web": {
          "default": "allow"
        },
        "terminal": {
          "default": "allow"
        }
      }
    },
    "default_model": {
      "provider": "zed.dev",
      "model": "gpt-5.6-sol",
      "enable_thinking": true,
      "effort": "xhigh"
    },
    "favorite_models": [],
    "model_parameters": []
  },
  "vim_mode": true,
  "ui_font_size": 16,
  "buffer_font_size": 15,
  "theme": {
    "mode": "system",
    "light": "Ayu Light",
    "dark": "Ayu Dark",
  },
}
