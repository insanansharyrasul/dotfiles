[credential "https://github.com"]
	helper = 
	helper = !/usr/bin/gh auth git-credential
[user]
	name = insanansharyrasul
	email = 63089983+insanansharyrasul@users.noreply.github.com
[color]
	ui = auto
[init]
	defaultBranch = main
[core]
	autocrlf = input
	pager = delta
[interactive]
	diffFilter = delta --color-only

[delta]
	navigate = true
	dark = true
	line-numbers = true
	side-by-side = false
	hyperlinks = true
	syntax-theme = Dracula

[diff]
	colorMoved = default
	algorithm = histogram
	mnemonicPrefix = true

[merge]
	conflictStyle = zdiff3

[alias]
	ds = diff --staged

# Machine-specific settings (safe.directory, work email, ...) go here, not in the repo.
[include]
	path = ~/.gitconfig.local
